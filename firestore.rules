rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Schedule entries
    match /schedule_entries/{document=**} {
      allow read, write: if true;
    }

    // Routine overrides
    match /routine_overrides/{document=**} {
      allow read, write: if true;
    }

    // Streak definitions and completions
    match /streak_definitions/{document=**} {
      allow read, write: if true;
    }

    match /streak_completions/{document=**} {
      allow read, write: if true;
    }

    // AI Work Log: Work Items (Projects, Tasks, Features, Experiments)
    match /work_items/{document=**} {
      allow read, write: if true;
    }

    // AI Work Log: Work Sessions
    match /work_sessions/{document=**} {
      allow read, write: if true;
    }
  }
}
